# versions.env
#
# Single source of truth for pinned tool and provider versions (ADR-010).
# Holds exact pins; activity required_providers constraints are derived from them.
# Consumed by the dev container, activities and CI (ADR-010, once added).
# Update deliberately in one merge request, together with the committed lock files.
#
# Pinned to the latest stable releases as of 2026-10-14.

TF_VERSION=1.16.5

AWS_PROVIDER_VERSION=6.68.0
GOOGLE_PROVIDER_VERSION=8.7.0
AZURERM_PROVIDER_VERSION=5.9.0
